# Database
# Optional. If set, this full URL is used instead of DB_HOST / DB_USER / etc.
DATABASE_URL=""
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD="your_db_password"
DB_NAME=afrigoals
DB_SSLMODE=disable

# SMTP (Mail)
SMTP_USERNAME=your_email@example.com
SMTP_PASSWORD="your_app_password"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Application
DOMAIN="http://localhost:3000"

# Auth - REQUIRED. The server will not start without this.
# Must be at least 32 characters. Generate one with:
#   openssl rand -hex 32
JWT_SECRET_KEY=""

# Admin User (initial setup) - REQUIRED, the server will not start without these.
# Leave ADMIN_PASSWORD empty here: the startup check rejects it, which is what
# forces a real value rather than one published in this repository.
# Must be at least 12 characters.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD=""

# Comma-separated browser origins allowed to call this API.
# The Next.js dev server runs on 3000.
ALLOWED_ORIGINS="http://localhost:3000,https://your-frontend-domain.com"

# Video analysis model server.
MODEL_SERVER_UPLOAD_URL=""
MODEL_SERVER_STATUS_URL=""
MODEL_SERVER_RESULT_URL=""

# Cloudflare R2 direct analyst video uploads.
# R2_ENDPOINT can be either:
#   https://<account_id>.r2.cloudflarestorage.com
# or the bucket S3 API URL copied from Cloudflare:
#   https://<account_id>.r2.cloudflarestorage.com/<bucket>
R2_ENDPOINT="https://1bee280eb770a22064a690a3db2308f9.r2.cloudflarestorage.com/afrigoalsanalyst"
R2_BUCKET="afrigoalsanalyst"
# Use an R2 S3 API token/key pair from R2 > Manage R2 API Tokens.
# Do not use a Cloudflare account API token JSON id here.
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
# Use the bucket Public Development URL for local/dev, or your custom R2 domain for production.
R2_PUBLIC_BASE_URL="https://media.afrigoals.com"

# Local development only. Lets GORM alter the schema on boot instead of using
# migrations/. Never enable this against a deployed database.
AUTO_MIGRATE=false
