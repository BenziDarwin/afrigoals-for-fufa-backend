# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD="your_db_password"
DB_NAME=afrigoals
DB_SSLMODE=disable

# SMTP (Mail)
SMTP_USERNAME=your_email@example.com
SMTP_PASSWORD="your_app_password"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Application
DOMAIN="http://localhost:3000"

# Auth - REQUIRED. The server will not start without this.
# Must be at least 32 characters. Generate one with:
#   openssl rand -hex 32
JWT_SECRET_KEY=""

# Admin User (initial setup) - REQUIRED, the server will not start without these.
# Leave ADMIN_PASSWORD empty here: the startup check rejects it, which is what
# forces a real value rather than one published in this repository.
# Must be at least 12 characters.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD=""

# Comma-separated browser origins allowed to call this API.
# The Next.js dev server runs on 3000.
ALLOWED_ORIGINS="http://localhost:3000"

# Video analysis model server.
MODEL_SERVER_UPLOAD_URL=""
MODEL_SERVER_STATUS_URL=""
MODEL_SERVER_RESULT_URL=""

# Local development only. Lets GORM alter the schema on boot instead of using
# migrations/. Never enable this against a deployed database.
AUTO_MIGRATE=false
